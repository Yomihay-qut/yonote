{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yonote",
  "version": "1.0.0",
  "identifier": "top.yomihay.yonote",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5178"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yonote",
        "width": 1240,
        "height": 820,
        "minWidth": 420,
        "minHeight": 580,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English", "Japanese", "Korean"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
