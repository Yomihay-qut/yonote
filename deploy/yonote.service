[Unit]
Description=Yonote notes and tasks
After=network.target

[Service]
Type=simple
User=yonote
Group=yonote
WorkingDirectory=/opt/yonote
EnvironmentFile=/etc/yonote.env
ExecStart=/opt/yonote/yonote -addr 127.0.0.1:8787 -data /var/lib/yonote -web /opt/yonote/web
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yonote

[Install]
WantedBy=multi-user.target
